<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Post in detail</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1>Here is your post in detail</h1>
  <div class="post">
    
    <p><strong>Username:</strong>
      <%= post.username %>
    </p>
    <p><strong>Content:</strong>
      <%= post.content %>
    </p>
  </div>


</body>

</html>